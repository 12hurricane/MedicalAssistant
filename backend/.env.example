# ── MedAssist AI — Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in the required values.
# Every key required by app/core/config.py is listed below with a blank value.

# ── Application ───────────────────────────────────────────────────────────────
PROJECT_NAME=
VERSION=
API_V1_PREFIX=

APP_NAME=
ENVIRONMENT=
DEBUG=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for local development; PostgreSQL via asyncpg for deployment.
DATABASE_URL=

# ── Authentication ───────────────────────────────────────────────────────────
# Generate a proper random secret before deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# ── Local Inference ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_MODEL=
EMBEDDING_MODEL=

# ── SQL Logging ──────────────────────────────────────────────────────────────
# Emits every SQL statement. Default is false in app/core/config.py.
SQL_ECHO=
