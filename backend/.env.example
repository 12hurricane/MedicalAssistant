# MedAssist AI Environment Variables Example
# Copy this file to .env and fill in the values before deploying.

# The name of the project
PROJECT_NAME="MedAssist AI"

# Environment: "development" or "production"
ENVIRONMENT="development"

# Set to False in production
DEBUG=True

# Database connection string
# For SQLite (default): "sqlite+aiosqlite:///./medication.db"
# For PostgreSQL: "postgresql+asyncpg://user:password@localhost/medassist"
DATABASE_URL="sqlite+aiosqlite:///./medication.db"

# Secret key for JWT encryption. Must be a long, random string in production!
# e.g., generate with: openssl rand -hex 32
SECRET_KEY=""

# Access and refresh token expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local Ollama URL (default loopback)
OLLAMA_BASE_URL="http://localhost:11434"

# Local models installed via ollama
OLLAMA_MODEL="qwen3:8b"
EMBEDDING_MODEL="nomic-embed-text"

# SQL logging - set to False to reduce log noise
SQL_ECHO=False
GEMINI_API_KEY=""
