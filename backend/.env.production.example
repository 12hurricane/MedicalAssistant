# =============================================================================
# MedAssist AI - Production Environment Configuration Template
# =============================================================================

PROJECT_NAME="MedAssist AI"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

APP_NAME="Medication Assistant API"
ENVIRONMENT="production"
DEBUG=false

# -----------------------------------------------------------------------------
# Database Configuration
# SQLite persistence: "sqlite+aiosqlite:////app/data/medication.db"
# PostgreSQL: "postgresql+asyncpg://user:password@postgres-host:5432/medassist"
# -----------------------------------------------------------------------------
DATABASE_URL="sqlite+aiosqlite:////app/medication.db"

# -----------------------------------------------------------------------------
# Security & JWT Token Configuration
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Lockdown: Comma-separated list of allowed origins (e.g. https://your-domain.com)
ALLOWED_ORIGINS="http://localhost,http://localhost:80,http://localhost:8080,https://your-medassist-domain.com"

# -----------------------------------------------------------------------------
# LLM Cascading Router Configuration
# Tier 1: Groq LPU (~1.5s ultra-low latency)
# Tier 2: Hugging Face Serverless
# Tier 3: Google Gemini API
# Tier 4: Local Ollama (Zero-internet fallback)
# -----------------------------------------------------------------------------
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

HF_TOKEN="hf_your_huggingface_token_here"
HF_AGENT_MODEL="meta-llama/Llama-3.1-8B-Instruct"

GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-flash-latest"
GEMINI_ENABLED=true
GEMINI_TIMEOUT=30.0

OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_MODEL="llama3.2:latest"
EMBEDDING_MODEL="nomic-embed-text"
